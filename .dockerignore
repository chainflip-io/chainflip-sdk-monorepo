# Keep the host's (macOS) build artifacts out of the build context so the
# container installs its own Linux-native binaries (prisma engines, esbuild, ...).
node_modules
**/node_modules
dist
**/dist
**/*.tsbuildinfo

.git
.github
.husky
coverage
**/coverage
test-ledger

*.log
**/*.log
dump.rdb

# Local env/secret material — the container loads .env.localnet only.
**/.env
**/.env.keys
**/.env.backspin
**/.env.sisyphos
**/.env.perseverance
**/.env.mainnet

.DS_Store
