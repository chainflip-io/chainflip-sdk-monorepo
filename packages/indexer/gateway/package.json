{
  "name": "indexer-gateway",
  "version": "2023.5.0",
  "description": "services supporting the swapping app",
  "license": "MIT",
  "scripts": {
    "start": "pnpm postgraphile --append-plugins postgraphile-plugin-connection-filter -c \"$DATABASE_URL\" --host 0.0.0.0 --port \"$PORT\" --dynamic-json --watch --retry-on-init-fail",
    "dev:localnet": "dotenvx run -f .env.localnet -- pnpm start"
  },
  "dependencies": {
    "postgraphile": "^4.14.1",
    "postgraphile-plugin-connection-filter": "^2.3.0"
  }
}
