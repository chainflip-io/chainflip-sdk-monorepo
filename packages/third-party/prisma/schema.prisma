// Third-party service schema (third-party swap providers, starting with SwapKit).
//
// This schema lives in the same Postgres database as the swap service but only manages the
// `third_party` Postgres schema. The swap service owns `public` and `private`; neither package's
// migrations touch the other's tables.
//
// The connection string MUST end with `?schema=third_party` so that Prisma keeps this package's
// `_prisma_migrations` table in the `third_party` schema, separate from the swap service's.
//
// `pnpm prisma format` after changes :)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/third-party"
}

datasource db {
  provider = "postgresql"
  schemas  = ["third_party"]
}

enum ThirdPartyProvider {
  SWAPKIT

  @@schema("third_party")
}

// same values as the swap service's `Chain` enum (public schema), which Prisma can't reference
// from this separate schema
enum Chain {
  Polkadot
  Ethereum
  Bitcoin
  Arbitrum
  Solana
  Assethub
  Tron
  Bsc

  @@schema("third_party")
}

enum ThirdPartySwapStatus {
  PENDING
  SWAPPING
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
  UNKNOWN

  @@schema("third_party")
}

enum ThirdPartySwapType {
  DEPOSIT_CHANNEL // the user sends funds to a provider deposit address
  WALLET // we return tx data and the user signs it in their wallet

  @@schema("third_party")
}

// one per swap started with a provider, created when we call the provider's swap endpoint.
// route, amounts and deposit channel are overwritten if the swap is re-requested or requoted
// before funds arrive. deleted after expiresAt if no swap was created for it
model ThirdPartySwapRequest {
  id                          String             @id @default(uuid(7))
  provider                    ThirdPartyProvider
  originType                  ThirdPartySwapType
  routeId                     String
  routeProviders              String[]
  srcChain                    Chain
  srcAsset                    String
  srcAddress                  String?
  destChain                   Chain
  destAsset                   String
  destAddress                 String
  refundAddress               String
  expectedSwapInputAmount     Decimal            @db.Decimal(30, 0)
  expectedSwapOutputAmount    Decimal            @db.Decimal(30, 0)
  expectedMinSwapOutputAmount Decimal            @db.Decimal(30, 0)
  slippageTolerancePercent    Decimal?
  affiliateFeeBps             Int
  depositChannelId            String?
  depositAddress              String?
  expiresAt                   DateTime           @db.Timestamptz(3)
  createdAt                   DateTime           @default(now()) @db.Timestamptz(3)
  swap                        ThirdPartySwap?

  @@unique([provider, depositChannelId])
  @@index([depositAddress])
  @@index([routeId])
  @@index([srcAddress])
  @@index([destAddress])
  @@index([refundAddress])
  @@index([expiresAt])
  @@map("ThirdPartySwapRequests")
  @@schema("third_party")
}

// a request that the provider has seen funds for
model ThirdPartySwap {
  id                       BigInt                @id @default(autoincrement())
  status                   ThirdPartySwapStatus  @default(PENDING)
  srcChain                 Chain
  txRef                    String // not unique: one bitcoin transaction can pay several deposit addresses
  swapInputAmount          Decimal?              @db.Decimal(30, 0)
  swapOutputAmount         Decimal?              @db.Decimal(30, 0)
  refundAmount             Decimal?              @db.Decimal(30, 0)
  effectiveSlippagePercent Decimal?
  effectiveAffiliateFeeBps Int?
  failureReason            String?
  providerStatus           Json?
  depositFinalisedAt       DateTime?             @db.Timestamptz(3)
  completedAt              DateTime?             @db.Timestamptz(3)
  createdAt                DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime              @updatedAt @db.Timestamptz(3)
  swapRequest              ThirdPartySwapRequest @relation(fields: [swapRequestId], references: [id])
  swapRequestId            String                @unique

  @@index([srcChain, txRef])
  @@index([status, updatedAt])
  @@map("ThirdPartySwaps")
  @@schema("third_party")
}
