// Third-party service schema (third-party swap providers, starting with SwapKit).
//
// This schema lives in the same Postgres database as the swap service but only manages the
// `third_party` Postgres schema. The swap service owns `public` and `private`; neither package's
// migrations touch the other's tables.
//
// The connection string MUST end with `?schema=third_party` so that Prisma keeps this package's
// `_prisma_migrations` table in the `third_party` schema, separate from the swap service's.
//
// `pnpm prisma format` after changes :)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/third-party"
}

datasource db {
  provider = "postgresql"
  schemas  = ["third_party"]
}

enum ThirdPartyProvider {
  SWAPKIT

  @@schema("third_party")
}

// mirrors SwapKit's `POST /track` statuses so the poller stores them without translation
enum ThirdPartySwapStatus {
  NOT_STARTED // swap created, user hasn't sent the tx yet
  PENDING // tx seen, waiting for confirmations
  SWAPPING // provider is executing the swap
  COMPLETED
  REFUNDED
  FAILED
  UNKNOWN // SwapKit can't determine the status yet; keep polling

  @@schema("third_party")
}

model ThirdPartySwap {
  id                 Int                  @id @default(autoincrement())
  provider           ThirdPartyProvider
  providerRouteId    String
  underlyingProvider String?
  status             ThirdPartySwapStatus @default(NOT_STARTED)
  srcAsset           String
  srcChainId         String
  srcAmount          Decimal              @db.Decimal(78, 0)
  srcAddress         String
  destAsset          String
  expectedDestAmount Decimal              @db.Decimal(78, 0)
  destAmount         Decimal?             @db.Decimal(78, 0)
  destAddress        String
  txHash             String?
  depositChannelId   String?
  depositAddress     String?
  affiliateFeeBps    Int
  providerStatus     Json?
  nextCheckAt        DateTime?            @db.Timestamptz(3)
  completedAt        DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([srcChainId, txHash])
  @@index([nextCheckAt])
  @@map("ThirdPartySwaps")
  @@schema("third_party")
}
