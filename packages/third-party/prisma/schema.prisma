// Third-party service schema (third-party swap providers, starting with SwapKit).
//
// This schema lives in the same Postgres database as the swap service but only manages the
// `third_party` Postgres schema. The swap service owns `public` and `private`; neither package's
// migrations touch the other's tables.
//
// The connection string MUST end with `?schema=third_party` so that Prisma keeps this package's
// `_prisma_migrations` table in the `third_party` schema, separate from the swap service's.
//
// `pnpm prisma format` after changes :)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/third-party"
}

datasource db {
  provider = "postgresql"
  schemas  = ["third_party"]
}

enum ThirdPartyProvider {
  SWAPKIT

  @@schema("third_party")
}

// same values as the swap service's `Chain` enum (public schema), which Prisma can't reference
// from this separate schema
enum Chain {
  Polkadot
  Ethereum
  Bitcoin
  Arbitrum
  Solana
  Assethub
  Tron
  Bsc

  @@schema("third_party")
}

enum ThirdPartySwapStatus {
  PENDING
  SWAPPING
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
  UNKNOWN

  @@schema("third_party")
}

enum ThirdPartySwapType {
  WALLET // we return tx data and the user signs it in their wallet
  DEPOSIT_ADDRESS // the user sends funds to a provider deposit address

  @@schema("third_party")
}

// a route the user chose and asked to execute (created on /swap, before any deposit)
model ThirdPartySwapRequest {
  id                   String             @id
  provider             ThirdPartyProvider
  routeId              String
  protocols            String[]
  type                 ThirdPartySwapType
  srcAsset             String
  srcChain             Chain
  srcAmount            Decimal            @db.Decimal(78, 0)
  srcAddress           String?
  destAsset            String
  destChain            Chain
  destAddress          String
  minDestAmount        Decimal            @db.Decimal(78, 0)
  expectedDestAmount   Decimal            @db.Decimal(78, 0)
  refundAddress        String?
  slippageToleranceBps Int
  affiliateFeeBps      Int
  depositChannelId     String?
  depositAddress       String?
  txDataHash           String? // hash of tx data returned for wallet swaps
  expiresAt            DateTime           @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  swap                 ThirdPartySwap?

  @@unique([provider, depositChannelId])
  @@index([routeId])
  @@index([expiresAt])
  @@map("ThirdPartySwapRequests")
  @@schema("third_party")
}

model ThirdPartySwap {
  id             Int                   @id @default(autoincrement())
  swapRequest    ThirdPartySwapRequest @relation(fields: [swapRequestId], references: [id])
  swapRequestId  String                @unique
  status         ThirdPartySwapStatus  @default(PENDING)
  txHash         String                @unique
  destAmount     Decimal?              @db.Decimal(78, 0)
  providerStatus Json?
  completedAt    DateTime?             @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)

  @@map("ThirdPartySwaps")
  @@schema("third_party")
}
