{
  "name": "third-party",
  "version": "0.0.1",
  "description": "Backend for third-party swap aggregators (SwapKit) used by swap.chainflip.io",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm clean && prisma generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch -r dotenv/config src/index.ts",
    "start": "node dist/packages/third-party/src/index.js",
    "postinstall": "prisma generate",
    "test": "vitest",
    "test:ci": "CI=1 pnpm test",
    "eslint:check": "pnpm eslint --max-warnings 0 './**/*.ts'",
    "prettier:base": "prettier ./** --ignore-path=../../.prettierignore",
    "prettier:check": "pnpm prettier:base --check",
    "prettier:write": "pnpm prettier:base --write",
    "typecheck": "tsc --noEmit",
    "generate:models": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "license": "ISC",
  "engines": {
    "node": "26.13.1",
    "pnpm": ">=12"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "pg": "^8.16.2",
    "prisma": "^7.10.0",
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2"
  }
}
