{
  "name": "@chainflip/sdk",
  "version": "2.3.4-dev.1",
  "description": "",
  "exports": {
    "./swap": {
      "require": {
        "types": "./dist/swap.d.cts",
        "default": "./dist/swap.cjs"
      },
      "import": {
        "types": "./dist/swap.d.ts",
        "default": "./dist/swap.js"
      }
    },
    "./funding": {
      "require": {
        "types": "./dist/funding.d.cts",
        "default": "./dist/funding.cjs"
      },
      "import": {
        "types": "./dist/funding.d.ts",
        "default": "./dist/funding.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "swap": [
        "dist/swap.d.ts"
      ],
      "funding": [
        "dist/funding.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:ci": "CI=1 pnpm test",
    "build": "rm -rf dist && tsup",
    "eslint:check": "pnpm eslint --max-warnings 0 './**/*.ts'",
    "prettier:base": "prettier ./** --ignore-path=../../.prettierignore",
    "prettier:check": "pnpm prettier:base --check",
    "prettier:write": "pnpm prettier:base --write",
    "typecheck": "pnpm integrators:generate && tsc --noEmit",
    "integrators:generate": "prisma generate",
    "integrators:build": "rm -rf dist-integrators && prisma generate && tsc -p tsconfig.integrators.json && tsc-alias -p tsconfig.integrators.json",
    "integrators:dev": "tsx watch -r dotenv/config src/integrators/index.ts",
    "integrators:start": "node dist-integrators/packages/sdk/src/integrators/index.js",
    "integrators:migrate:dev": "prisma migrate dev",
    "integrators:migrate:deploy": "prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^20 || ^22 || ^24 || ^26",
    "pnpm": ">=9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chainflip-io/chainflip-sdk-monorepo.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@chainflip/bitcoin": "2.3.3",
    "@chainflip/rpc": "2.3.4",
    "@chainflip/solana": "2.3.3",
    "@chainflip/utils": "2.3.7",
    "axios": "^1.15.0",
    "bignumber.js": "^9.3.0",
    "ethers": "^6.14.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/supertest": "^7.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "pg": "^8.16.2",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.0",
    "winston": "^3.17.0"
  }
}
